POSTGRES_DB=buildwise
POSTGRES_USER=buildwise
POSTGRES_PASSWORD=change-this-postgres-password

AUTH_SECRET_KEY=change-this-auth-secret-key
AUTH_TOKEN_TTL_MINUTES=480

# Dominio publico del backend. Debe apuntar por DNS a la IP flotante de OpenStack.
API_DOMAIN=api-buildwise.example.edu.ar

# Frontends autorizados para consumir la API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://buildwise-tif.vercel.app

CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gemma4-26b
OPENAI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024
